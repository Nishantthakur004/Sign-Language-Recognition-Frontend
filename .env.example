# Backend API base URL. Must include the /api suffix and no trailing slash.
# Local development:
VITE_API_BASE_URL=http://localhost:8000/api
# Production example (set this in your hosting provider):
# VITE_API_BASE_URL=https://your-backend-domain.com/api

# Optional request timeouts in milliseconds.
# VITE_API_TIMEOUT_MS=20000
# VITE_API_UPLOAD_TIMEOUT_MS=180000

# Multipart field accepted by POST /api/recognition/predict.
VITE_PREDICTION_FILE_FIELD=file

# MediaPipe runtime and model assets. These defaults use the official Google CDN.
VITE_MEDIAPIPE_WASM_URL=https://cdn.jsdelivr.net/npm/@mediapipe/tasks-vision@0.10.35/wasm
VITE_HAND_LANDMARKER_MODEL_URL=https://storage.googleapis.com/mediapipe-models/hand_landmarker/hand_landmarker/float16/1/hand_landmarker.task

# Frame transport defaults.
VITE_FRAME_WIDTH=640
VITE_JPEG_QUALITY=0.72
VITE_FRAME_INTERVAL_MS=250
VITE_CONFIDENCE_THRESHOLD=0.65
